generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/client/deployment"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstanceStatus {
  PENDING
  SCHEDULING
  PROVISIONING
  RUNNING
  TERMINATING
  TERMINATED
  FAILED
}

model Instance {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String
  status        InstanceStatus @default(PENDING)
  cpuMillicores Int
  memoryMb      Int
  imageType     String
  workerNodeId  String?
  containerId   String?
  sshPort       Int?
  ip            String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  terminatedAt  DateTime?

  @@map("instances")
}
