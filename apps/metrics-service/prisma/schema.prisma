generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/client/metrics"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InstanceOwnership {
  instanceId String   @id @db.Uuid
  userId     String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("instance_ownership")
}

model InstanceMetric {
  id           BigInt   @id @default(autoincrement())
  instanceId   String   @db.Uuid
  userId       String   @db.Uuid
  cpuPercent   Decimal  @db.Decimal(5, 2)
  memoryMb     Int
  networkInKb  Int
  networkOutKb Int
  recordedAt   DateTime

  @@index([instanceId, recordedAt(sort: Desc)])
  @@index([userId, recordedAt(sort: Desc)])
  @@map("instance_metrics")
}
