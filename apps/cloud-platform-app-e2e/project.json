{
  "name": "cloud-platform-app-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["cloud-platform-app"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/cloud-platform-app-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["cloud-platform-app:build", "cloud-platform-app:serve"]
    }
  }
}
